@model QuanLyRapPhim.Models.NhanVien

@{
    ViewBag.Title = "Thông Tin Nhân Viên";
    Layout = null;
}

<link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css">

<img src="~/img/pexels-tima-miroshnichenko-7991375.jpg"
     style="opacity: 0.9;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            z-index: -1;" />

<div id="wrapper">
    <form id="form-login" method="post">

        <h1 class="form-heading">Hồ sơ cá nhân</h1>

        <div class="form-group">
            <i class="far fa-user"></i>
            <input type="text" class="form-input" placeholder="Họ và tên" value="@Model.TenNV" readonly />
        </div>

        <div class="form-group">
            <i class="fas fa-phone-alt" style="font-size: 13px;"></i>
            <input type="text" class="form-input" placeholder="Số điện thoại" value="@Model.SDT" readonly />
        </div>

        <div class="form-group">
            <i class="far fa-envelope"></i>
            <input type="text" class="form-input" placeholder="Email" value="@Model.Email" readonly />
        </div>

        <div class="form-group">
            <i class="far fa-calendar-alt"></i>
            <input type="text" class="form-input" value="@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "")" readonly />
        </div>

        <div class="form-group">
            <i class="fas fa-id-badge"></i>
            <input type="text" class="form-input" value="@Model.VaiTro" readonly />
        </div>

        <div style="display: flex; gap: 10px; margin-top: 40px;">
            <a href="@Url.Action("DangXuat", "DangNhapNhanVien")" class="form-submit" style="text-align:center; text-decoration:none; background: rgba(255, 255, 255, 0.2);">
                Đăng xuất
            </a>
        </div>

    </form>
</div>

<style>
    #wrapper {
        width: 100%;
        height: 100%;
        display: flex;
    }

    #form-login {
        max-width: 450px;
        background: rgba(0,0,0,0.8);
        flex-grow: 1;
        padding: 10px 30px 40px;
        box-shadow: 0px 0px 17px 2px rgba(255,255,255,0.8);
        margin: auto;
        border-radius: 5px;
    }

    .form-heading {
        color: white;
        text-align: center;
        margin-bottom: 20px;
    }

    .form-group i {
        color: white;
        font-size: 14px;
        padding-top: 5px;
        width: 20px;
        text-align: center;
    }

    .form-group {
        margin-top: 15px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(255,255,255,0.2);
        padding-bottom: 5px;
    }

    .form-input {
        background: transparent;
        outline: 0;
        border: none;
        flex-grow: 1;
        margin-left: 10px;
        height: 35px;
        color: white;
        font-size: 16px;
    }

        .form-input::placeholder {
            color: rgb(112, 112, 112);
        }

    .form-group:focus-within {
        border-bottom: 1px solid white;
    }

    .form-submit {
        background: transparent;
        color: white;
        width: 100%;
        text-transform: uppercase;
        padding: 10px 10px;
        border: 1px solid white;
        transition: 0.3s;
        font-weight: bold;
    }

        .form-submit:hover {
            cursor: pointer;
            background-color: white;
            color: black;
        }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.js"></script>
