<!DOCTYPE html><html><head>    <meta name="viewport" content="width=device-width" />    <title>@ViewBag.Title - Huce Cinema</title>    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script></head><body>    <header>        <nav>            <div id="the-logo" style="display:flex;align-items:center;gap:10px; width: 100%">                <img class="logo-image" src="@Url.Content("~/img/Logo.jpg")" alt="Logo Huce Cinema" style="height:45px;width:auto;" />                <p class="logo">Huce<span>Cinema</span></p>                <a href="@Url.Action("LichSuDatVe", "Profile")" class="btn-history">                    <i class="fa fa-ticket" aria-hidden="true"></i> Vé của tôi                </a>            </div>            <i class="fa fa-bars" id="menu"></i>            @*<ul id="menu-box">                    <li><a href="@Url.Action("TrangChuKhachHang", "TrangChuKhachHang")">Phim</a></li>                    <li><a href="#">Rạp chiếu phim</a></li>                    <li><a href="#">Đăng kí tài khoản</a></li>                    <li><a href="#">Đăng nhập</a></li>                </ul>*@        </nav>    </header>    <main>        @RenderBody()    </main>    <footer>        <div class="footer-main-row">            <div class="footer-left" style="display:flex; align-items:center; border-right: 1px solid #333333; padding-right: 40px; margin-right: 40px;">                <div class="footer-logo" style="display:flex; flex-direction:column; align-items:center;">                    <img src="~/img/Logo.jpg" alt="HUCE CINEMA Logo" style="width:50px; height:auto; background-color:white; margin-bottom: 5px;" />                    <p class="name" style="font-size:14px; color:white; margin:0;">HUCE CINEMA</p>                </div>            </div>            <div class="footer-content" style="display:flex; align-items:center;">                <h3 style="font-size:16px; font-weight:bold; margin:0 20px 0 0; color:white; text-transform:uppercase;">ĐANG PHÁT</h3>                <div class="film-list" style="display:flex; align-items:center;">                    <span style="margin-right:15px;"><a href="#" style="color:white; text-decoration:none;">AVENGERS ENDGAME</a></span>                    <span style="margin-right:15px;"><a href="#" style="color:white; text-decoration:none;">DUNE PART TWO</a></span>                    <span style="margin-right:15px;"><a href="#" style="color:white; text-decoration:none;">INSIDE OUT 2</a></span>                    <span style="margin-right:15px;"><a href="#" style="color:white; text-decoration:none;">TẤT CẢ CÁC PHIM</a></span>                </div>            </div>        </div>        <div class="footer-bottom-row" style="padding-top:15px; margin-top:20px; border-top:1px solid #333333; width:100%; max-width:1200px; text-align:center;">            <a href="https://www.facebook.com/?locale=vi_VN" target="_blank"><i class="fa fa-facebook" style="font-size:24px; margin:0 10px; color:white;"></i></a>            <a href="https://www.youtube.com/?app=desktop&hl=vi" target="_blank"><i class="fa fa-youtube-play" style="font-size:24px; margin:0 10px; color:white;"></i></a>            <a href="https://www.instagram.com/" target="_blank"><i class="fa fa-instagram" style="font-size:24px; margin:0 10px; color:white;"></i></a>        </div>    </footer>    <style>        /* CSS FIX CẤU TRÚC LAYOUT */        .btn-history {            background-color: #e74c3c;            color: white !important;            padding: 8px 15px;            border-radius: 20px;            text-decoration: none;            font-weight: bold;            font-family: Arial, sans-serif;            font-size: 14px;            margin-right: 20px;            transition: all 0.3s ease;            display: flex;            align-items: center;            gap: 8px;            border: 1px solid #e74c3c;        }        body {            margin: 0;            padding: 0;        }        header {            background-color: black;            width: 100%;            height: 60px;            position: fixed;            top: 0;            left: 0;            z-index: 100;            padding-top: 0;        }            header nav {                position: relative;                z-index: 5;                height: 100%;                display: flex;                align-items: center;                justify-content: space-between;                padding: 0 40px;            }        #menu-box {            font-family: 'Times New Roman';        }            #menu-box li a {                color: aliceblue;                text-decoration: none;            }        main {            padding-top: 60px;        }        /* ⬅️ Bù đắp cho Navbar */        /* CSS Footer (Đảm bảo Footer luôn nằm dưới nội dung) */        footer {            background-color: #000000;            color: #ffffff;            padding: 30px 0 10px 0;            font-family: Arial, sans-serif;            display: flex;            flex-direction: column;            align-items: center;            width: 100%;        }        .footer-main-row {            display: flex;            justify-content: center;            align-items: center;            width: 100%;            max-width: 1200px;            padding: 0 40px;        }    </style></body></html>