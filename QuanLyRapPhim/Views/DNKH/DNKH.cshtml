@{
    Layout = null;
    ViewBag.Title = "Đăng nhập";
}

<style>
    body {
        background-color: #ffffff;
        font-family: Arial, sans-serif;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-box {
        background: white;
        padding: 30px 40px;
        border-radius: 15px;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        width: 350px;
        text-align: center;
    }

        .login-box h2 {
            margin-bottom: 25px;
            color: #333;
        }

    input[type="email"],
    input[type="password"],
    input[type="text"] {
        width: 100%;
        padding: 10px;
        margin: 10px 0;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 14px;
        box-sizing: border-box;
    }

    .toggle-text {
        margin-top: -5px;
        margin-bottom: 10px;
        font-size: 13px;
        color: #007bff;
        cursor: pointer;
        text-align: right;
        display: block;
    }

        .toggle-text:hover {
            text-decoration: underline;
        }

    button {
        width: 100%;
        padding: 10px;
        border: none;
        background-color: #28a745;
        color: white;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        margin-top: 10px;
    }

        button:hover {
            background-color: #1e7e34;
        }

    .switch-btn {
        width: 100%;
        padding: 10px;
        background-color: #007bff;
        border: none;
        border-radius: 8px;
        color: white;
        margin-top: 10px;
        cursor: pointer;
        font-weight: bold;
    }

        .switch-btn:hover {
            background-color: #0056b3;
        }

    .message {
        margin-top: 15px;
        color: red;
    }
</style>

<div class="login-box">
    <h2>Đăng nhập</h2>

    <form method="post">
        <input type="text" name="tentk" placeholder="Nhập tên tài khoản" required />

        <input type="password" id="matkhau" name="matkhau" placeholder="Nhập mật khẩu" required />
        <span class="toggle-text" onclick="togglePassword()">Hiện mật khẩu</span>

        <button type="submit">Đăng nhập</button>
    </form>

    @if (ViewBag.ThongBao != null)
    {
        <div class="message">@ViewBag.ThongBao</div>
    }

    <button class="switch-btn" onclick="location.href='@Url.Action("DKKH", "DKKH")'">
        Chưa có tài khoản? Đăng ký ngay
    </button>
</div>

<script>
    function togglePassword() {
        const input = document.getElementById("matkhau");
        const toggleText = document.querySelector(".toggle-text");

        if (input.type === "password") {
            input.type = "text";
            toggleText.textContent = "Ẩn mật khẩu";
        } else {
            input.type = "password";
            toggleText.textContent = "Hiện mật khẩu";
        }
    }
</script>