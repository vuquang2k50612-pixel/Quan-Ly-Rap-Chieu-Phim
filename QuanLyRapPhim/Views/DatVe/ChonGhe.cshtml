@model List<QuanLyRapPhim.ViewModels.GheViewModel>
@{
    ViewBag.Title = "Chọn Ghế Xem Phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container mt-4 mb-5">
    <h2 class="text-center mb-3 fw-bold" id="tenPhim">Sơ Đồ Ghế - @ViewBag.TenPhim</h2>
    <p class="text-center text-muted"><strong>Phòng:</strong> @ViewBag.TenPhong | <strong>Suất chiếu:</strong> <span id="gioChieu">@ViewBag.GioChieu</span></p>
    
    <div class="row mb-3 justify-content-center">
        <div class="col-md-3 col-6"><div class="alert alert-success text-center py-2 mb-2"><strong>Số Ghế Trống:</strong> <span id="gheTrong">0</span></div></div>
        <div class="col-md-3 col-6"><div class="alert alert-danger text-center py-2 mb-2"><strong>Số Ghế Đã Bán:</strong> <span id="gheBan">0</span></div></div>
    </div>

    <div class="mb-4 text-center">
        <h6 class="text-uppercase text-muted">Chú Thích Trạng Thái:</h6>
        <div class="d-inline-flex gap-4">
            <div><div style="width:20px;height:20px;background:#28a745;display:inline-block;margin-right:8px;border-radius:4px;"></div> Ghế Trống</div>
            <div><div style="width:20px;height:20px;background:#dc3545;display:inline-block;margin-right:8px;border-radius:4px;"></div> Đã Bán</div>
            <div><div style="width:20px;height:20px;background:#007bff;display:inline-block;margin-right:8px;border-radius:4px;"></div> Đang Chọn</div>
        </div>
    </div>

    <!-- Màn hình chiếu -->
    <div class="screen-bar text-center mb-4">
        <div class="screen-line"></div>
        <small class="text-muted fw-bold text-uppercase">Màn Hình Chiếu</small>
    </div>

    <div class="seat-grid" id="seatContainer">
        @if (Model != null && Model.Count > 0)
        {
            foreach (var g in Model)
            {
                <div class="seat @g.CssClass" data-id="@g.ID_Ghe" data-soghe="@g.So_Ghe" title="@(g.IsAvailable ? "Trống" : "Đã bán") - Ghế @g.So_Ghe">@g.So_Ghe</div>
            }
        }
    </div>

    <!-- NÚT CHUYỂN SANG TRANG ĐỒ ĂN -->
    <div class="text-center mt-5">
        <button id="btnTiepTuc" class="btn btn-success btn-lg px-5 shadow-lg" disabled>
            <i class="bi bi-cart"></i> TIẾP TỤC CHỌN ĐỒ ĂN UỐNG
            (<span id="soGheChon">0</span> ghế - <span id="tongTien">0</span>₫)
        </button>
        <a href="javascript:history.back()" class="btn btn-secondary btn-lg px-5 ms-3">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script>
    $(function () {
        var idSuatChieu = @(ViewBag.IDSuatChieu ?? 0);
        var gheDaChon = [];
        var giaVe = @(ViewBag.GiaVe ?? 0);
        var idTK = '@Session["ID_TK"]';

        // Cập nhật số ghế trống / đã bán từ dữ liệu server đã render
        var tongGhe = $('.seat').length;
        var gheBanCount = $('.seat.sold').length;
        $('#gheBan').text(gheBanCount);
        $('#gheTrong').text(tongGhe - gheBanCount);

        // Click chọn ghế
        $(document).on('click', '.seat.available', function () {
            $(this).toggleClass('selected');
            var soghe = $(this).data('soghe');

            if ($(this).hasClass('selected')) {
                gheDaChon.push(soghe);
            } else {
                gheDaChon = gheDaChon.filter(x => x !== soghe);
            }

            $('#soGheChon').text(gheDaChon.length);
            $('#tongTien').text((gheDaChon.length * giaVe).toLocaleString('vi-VN'));
            $('#btnTiepTuc').prop('disabled', gheDaChon.length === 0);
        });

        $('#btnTiepTuc').click(function () {
            if (gheDaChon.length === 0) {
                alert("Vui lòng chọn ít nhất 1 ghế!");
                return;
            }
            var tongVe = gheDaChon.length * giaVe;
            var url = '/DatVe/ChonDoAn?id=' + idSuatChieu + '&ghe=' + encodeURIComponent(gheDaChon.join(', ')) + '&tongVe=' + tongVe + '&idTK=' + idTK;
            window.location.href = url;
        });
    });
</script>

<style>
    .screen-bar {
        max-width: 520px;
        margin: 0 auto;
    }
    .screen-line {
        height: 6px;
        background: linear-gradient(90deg, #94a3b8, #3b82f6, #94a3b8);
        border-radius: 4px;
        margin-bottom: 6px;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    }
    .seat-grid {
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        gap: 10px;
        max-width: 520px;
        margin: 0 auto;
    }
    .seat {
        width: 42px;
        height: 42px;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 2px solid #334155;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        user-select: none;
    }
    .seat.available {
        background-color: #28a745;
        color: white;
    }
    .seat.available:hover {
        transform: scale(1.12);
    }
    .seat.sold {
        background-color: #dc3545;
        color: white;
        cursor: not-allowed;
        opacity: 0.85;
    }
    .seat.selected {
        background-color: #007bff !important;
        color: white;
        transform: scale(1.15);
        box-shadow: 0 0 15px rgba(0, 123, 255, 0.8);
    }
</style>
