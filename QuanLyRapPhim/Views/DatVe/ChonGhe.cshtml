@model dynamic
@{
    ViewBag.Title = "Chọn Ghế";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container mt-4">
    <h2 class="text-center mb-3" id="tenPhim">Sơ Đồ Ghế</h2>
    <p class="text-center"><strong>Giờ Chiếu:</strong> <span id="gioChieu"></span></p>
    <div class="row mb-3">
        <div class="col-md-6"><div class="alert alert-success"><strong>Số Ghế Trống:</strong> <span id="gheTrong">0</span></div></div>
        <div class="col-md-6"><div class="alert alert-danger"><strong>Số Ghế Đã Bán:</strong> <span id="gheBan">0</span></div></div>
    </div>
    <div class="mb-3 text-center">
        <h5>Chú Thích:</h5>
        <div class="d-inline-flex gap-4">
            <div><div style="width:20px;height:20px;background:#28a745;display:inline-block;margin-right:8px;"></div> Ghế Trống</div>
            <div><div style="width:20px;height:20px;background:#dc3545;display:inline-block;margin-right:8px;"></div> Đã Bán</div>
            <div><div style="width:20px;height:20px;background:#007bff;display:inline-block;margin-right:8px;"></div> Đang Chọn</div>
        </div>
    </div>
    <h3 class="mb-3 text-center">Sơ Đồ Ghế</h3>
    <div class="seat-grid" id="seatContainer"></div>
    <!-- NÚT CHUYỂN SANG TRANG ĐỒ ĂN -->
    <div class="text-center mt-5">
        <button id="btnTiepTuc" class="btn btn-success btn-lg px-5 shadow-lg" disabled>
            <i class="bi bi-cart"></i> TIẾP TỤC CHỌN ĐỒ ĂN UỐNG
            (<span id="soGheChon">0</span> ghế - <span id="tongTien">0</span>₫)
        </button>
        <a href="javascript:history.back()" class="btn btn-secondary btn-lg px-5 ms-3">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(function () {
        var id = window.location.pathname.split('/').pop();
        var gheDaChon = [];
        var giaVe = @(Convert.ToInt64(ViewBag.GiaVe ?? 0));
        var idTK = '@Session["ID_TK"]';

        $.ajax({
            url: '/SuatChieu/LayGhe',
            type: 'GET',
            data: { id: id },
            dataType: 'json',
            success: function (r) {
                if (!r.success) {
                    alert("Không tìm thấy suất chiếu!");
                    return;
                }
                $('#tenPhim').text('Sơ Đồ Ghế - ' + r.tenPhim);
                $('#gioChieu').text(r.gioChieu);
                $('#gheTrong').text(r.gheList.length - r.gheDaBan.length);
                $('#gheBan').text(r.gheDaBan.length);
                var html = '';
                r.gheList.forEach(function (g) {
                    var daBan = r.gheDaBan.includes(g.ID_Ghe);
                    var cls = daBan ? 'occupied' : 'available';
                    var tt = daBan ? 'Đã bán' : 'Trống';
                    html += `<div class="seat ${cls}" data-soghe="${g.So_Ghe}" title="${tt} - Ghế ${g.So_Ghe}">${g.So_Ghe}</div>`;
                });
                $('#seatContainer').html(html);
            }
        });

        // CHỌN GHẾ – LƯU SỐ GHẾ (So_Ghe)
        $(document).on('click', '.seat.available', function () {
            $(this).toggleClass('selected');
            var soghe = $(this).data('soghe');

            if ($(this).hasClass('selected')) {
                gheDaChon.push(soghe);
            } else {
                gheDaChon = gheDaChon.filter(x => x !== soghe);
            }

            $('#soGheChon').text(gheDaChon.length);
            $('#tongTien').text((gheDaChon.length * giaVe).toLocaleString('vi-VN'));
            $('#btnTiepTuc').prop('disabled', gheDaChon.length === 0);
        });


        $('#btnTiepTuc').click(function () {
            if (gheDaChon.length === 0) {
                alert("Vui lòng chọn ít nhất 1 ghế!");
                return;
            }
            var url = '/DatVe/ChonDoAn?id=' + id + '&ghe=' + gheDaChon.join(', ') + '&tongVe=' + (gheDaChon.length * giaVe) + '&idTK=' + idTK;
            window.location.href = url;
        });
    });
</script>

<style>
    .seat-grid {
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        gap: 10px;
        max-width: 500px;
        margin: 0 auto;
    }

    .seat {
        width: 40px;
        height: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 2px solid #333;
        border-radius: 5px;
        font-weight: bold;
        cursor: pointer;
        transition: transform 0.2s;
    }

        .seat.available {
            background-color: #28a745;
            color: white;
        }

            .seat.available:hover {
                transform: scale(1.1);
            }

        .seat.occupied {
            background-color: #dc3545;
            color: white;
            cursor: not-allowed;
        }

        .seat.selected {
            background-color: #007bff !important;
            transform: scale(1.15);
            box-shadow: 0 0 20px #007bff;
        }
</style>
