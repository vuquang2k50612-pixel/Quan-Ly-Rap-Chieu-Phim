
@{
    ViewBag.Title = "ThemDoAn";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<div class="container mt-4">
    <h3 class="fw-bold text-primary mb-3">Thêm mới đồ ăn</h3>
    <hr />

    <div class="bg-white p-4 rounded-3">
        <form id="form-act">
            <div class="mb-3">
                <label for="txt_TenDoAn" class="form-label fw-semibold">Tên đồ ăn</label>
                <input type="text" class="form-control" id="txt_TenDoAn" name="txt_TenDoAn" />
            </div>
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label fw-semibold">Số lượng</label>
                <input type="text" class="form-control" id="txt_SoLuong" name="txt_SoLuong" />
            </div>
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label fw-semibold">Mô tả</label>
                <input type="text" class="form-control" id="txt_MoTa" name="txt_MoTa" />
            </div>
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label fw-semibold">Giá</label>
                <input type="text" class="form-control" id="txt_Gia" name="txt_Gia" />
            </div>
            <div class="mb-3">
                <label for="txt_Anh" class="form-label fw-semibold">Ảnh món</label>
                <input type="file" class="form-control" id="txt_Anh" name="txt_Anh" accept="image/*" />
            </div>
            <div class="mt-4">
                <button type="button" id="btn_them" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Thêm mới</button>
                <button type="button" id="btn_quaylai" class="btn btn-secondary"><i class="bi bi-arrow-left-circle"></i> Quay lại</button>
            </div>
        </form>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $("#btn_them").click(function () {
        var form = $('#form-act')[0];
        var formData = new FormData(form);
        $.ajax({
            type: "POST",
            url: "/QuanLyDoAn/InsertDoAn",
            data: formData,
            processData: false,
            contentType: false,
            cache: false,
            success: function (response) {
                alert(response);
                if (response.toLowerCase().includes("thành công")) {
                    $('#form-act')[0].reset();
                }
            },
            error: function (data) {
                console.log(data);
            }
        });
    });

    $("#btn_quaylai").click(function () {
        window.location.href = "/QuanLyDoAn/DSDoAn";
    });
</script>

