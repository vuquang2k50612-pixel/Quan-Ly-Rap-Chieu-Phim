@{
    ViewBag.Title = "Xem Ghế";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<div class="container mt-4">
    <h2 class="text-center mb-3" id="tenPhim">Sơ Đồ Ghế</h2>
    <p class="text-center"><strong>Giờ Chiếu:</strong> <span id="gioChieu"></span></p>

    <div class="row mb-3">
        <div class="col-md-6"><div class="alert alert-success"><strong>Số Ghế Trống:</strong> <span id="gheTrong">0</span></div></div>
        <div class="col-md-6"><div class="alert alert-danger"><strong>Số Ghế Đã Bán:</strong> <span id="gheBan">0</span></div></div>
    </div>

    <div class="mb-3">
        <h5>Chú Thích:</h5>
        <div class="d-flex">
            <div class="me-3"><div style="width:20px;height:20px;background:green;display:inline-block;margin-right:5px;"></div> Ghế Trống</div>
            <div><div style="width:20px;height:20px;background:red;display:inline-block;margin-right:5px;"></div> Ghế Đã Bán</div>
        </div>
    </div>

    <h3 class="mb-3">Sơ Đồ Ghế</h3>
    <div class="seat-grid" id="seatContainer"></div>
</div>

<style>
    .seat-grid {
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        gap: 10px;
        max-width: 500px;
        margin: 0 auto;
    }

    .seat {
        width: 40px;
        height: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 2px solid #333;
        border-radius: 5px;
        font-weight: bold;
        cursor: pointer;
        transition: transform 0.2s;
    }

        .seat.available {
            background-color: #28a745;
            color: white;
        }

        .seat.occupied {
            background-color: #dc3545;
            color: white;
            cursor: not-allowed;
        }

        .seat:hover:not(.occupied) {
            transform: scale(1.1);
        }
</style>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(function () {
        // Lấy ID suất chiếu từ cuối URL (ví dụ: /XemGhe/123 → lấy 123)
        var id = window.location.pathname.split('/').pop();
        $.ajax({
            url: '/SuatChieu/LayGhe',
            type: 'GET',
            data: { id: id },
            dataType: 'json', // jQuery tự parse chuỗi thành object
            cache: false, // không cache để luôn lấy dữ liệu mới
            success: function (r) {
                if (!r.success) {
                    alert("Không tìm thấy suất chiếu!");
                    return;
                }
                // tên phim
                $('#tenPhim').text('Sơ Đồ Ghế - ' + r.tenPhim);
                // giờ chiếu
                $('#gioChieu').text(r.gioChieu);
                // số ghế trống
                $('#gheTrong').text(r.gheList.length - r.gheDaBan.length);
                // số ghế đã bán
                $('#gheBan').text(r.gheDaBan.length);
                var html = '';
                r.gheList.forEach(function (g) {
                    var daBan = r.gheDaBan.includes(g.ID_Ghe);
                    var cls, tt;
                    if (daBan) {
                        cls = 'occupied';
                        tt = 'Đã bán';
                    } else {
                        cls = 'available';
                        tt = 'Trống';
                    }
                    html += `<div class="seat ${cls}" title="${tt} - Ghế ${g.So_Ghe}">${g.So_Ghe}</div>`;
                });
                // hiển thị sơ đồ ghế
                $('#seatContainer').html(html);
            },
            error: function (xhr, status, err) {
                alert('Lỗi tải sơ đồ ghế: ' + (err || status));
                console.error(xhr.responseText);
            }
        });
    });
</script>
