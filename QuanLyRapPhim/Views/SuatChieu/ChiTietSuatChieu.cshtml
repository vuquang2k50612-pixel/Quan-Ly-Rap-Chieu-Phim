@model IEnumerable<QuanLyRapPhim.Models.SuatChieu>

<h2> Suất chiếu của phim: @ViewBag.TenPhim</h2>

<table class="table table-bordered mt-3">
    <thead class="table-light">
        <tr>
            <th>ID Suất Chiếu</th>
            <th>Phòng Chiếu</th>
            <th>Giờ Chiếu</th>
            <th>Giá Vé</th>
            <th>Thao Tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID_SuatChieu</td>
                <td>@item.ID_Phong</td>
                <td>@item.GioChieu</td>
                <td>@String.Format("{0:N0} VNĐ", item.Gia)</td>
                <td>
                    <a href="/SuatChieu/XemGhe/@item.ID_SuatChieu" class="btn btn-info btn-sm">
                        Xem Ghế
                    </a>
                    <button type="button" class="btn btn-danger btn-sm btnXoaSC"
                            data-id="@item.ID_SuatChieu"
                            data-ten="@ViewBag.TenPhim">
                        Xóa
                    </button>
                </td>

            </tr>
        }
    </tbody>
</table>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).on('click', '.btnXoaSC', function () {
        var btn = $(this);
        var id = btn.data('id');
        var tenPhim = btn.data('ten');

        // Confirm đẹp + có tên phim để người dùng chắc chắn
        if (!confirm(`Bạn có chắc chắn muốn XÓA suất chiếu của phim:\n"${tenPhim}"\nID suất: ${id}?\n\nHành động này không thể hoàn tác!`)) {
            return;
        }

        $.post('/SuatChieu/XoaSC', { id: id }, function (res) {
            alert(res); 
            if (res.includes("thành công")) {
                btn.closest('tr').fadeOut(400, function () {
                    $(this).remove();
                });
                // Nếu bảng trống → hiện thông báo
                if ($('tbody tr').length === 0) {
                    $('tbody').html('<tr><td colspan="5" class="text-center text-muted">Không còn suất chiếu nào</td></tr>');
                }
            }
        }).fail(function () {
            alert("Lỗi kết nối server!");
        });
    });
</script>
